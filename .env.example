# ═════════════════════════════════════════════════════════════════════════════
#  StudyAI (etudiantia) — configuration
#  Copie ce fichier en « .env » puis remplis les valeurs :   cp .env.example .env
#  Ne commite JAMAIS le fichier .env sur GitHub (il est déjà dans .gitignore).
#  Écris les valeurs SANS guillemets et SANS espaces.
#  Après toute modification :  docker compose up -d
# ═════════════════════════════════════════════════════════════════════════════

# ── Accès (OBLIGATOIRE) ──────────────────────────────────────────────────────
# Clé demandée à l'ouverture de l'application. 8 caractères minimum.
# Utilise des lettres, chiffres, tirets (évite $ # " ' \ et les espaces).
# Idée : openssl rand -hex 12
ACCESS_KEY=

# PIN de l'espace administrateur (4 caractères minimum). Vide = admin désactivé.
ADMIN_PIN=

# ── Intelligence artificielle (Anthropic) ────────────────────────────────────
# Clé API créée sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modèle utilisé pour analyser les cours (photos) et générer les quiz
ANTHROPIC_MODEL=claude-sonnet-5-5

# (Optionnel) Modèle différent, plus économique, pour la génération des quiz uniquement.
# Laisse vide pour utiliser ANTHROPIC_MODEL.
ANTHROPIC_MODEL_QUIZ=

# Garde-fou coût : nombre maximum d'appels IA (analyses + quiz) par profil et par jour.
# 0 = illimité. Les cours déjà enregistrés se révisent sans limite et sans appel IA.
DAILY_AI_LIMIT=30

# ── Réseau ───────────────────────────────────────────────────────────────────
# Port d'accès sur la VM : http://IP-DE-LA-VM:8080
HOST_PORT=8080

# Fuseau horaire (séries de jours consécutifs, dates des logs)
TZ=Europe/Paris

# ── Profils ──────────────────────────────────────────────────────────────────
# Profils créés automatiquement au tout premier démarrage (séparés par des virgules).
# Exemple : DEFAULT_PROFILES=Xavier,Emma,Lucas
DEFAULT_PROFILES=

# true : n'importe qui ayant la clé peut créer un profil depuis l'écran de choix.
# false : seul l'administrateur (PIN) peut en créer.
ALLOW_PROFILE_CREATION=true
MAX_PROFILES=12

# ── Sessions & HTTPS (options avancées) ──────────────────────────────────────
# Durée de mémorisation de la clé sur un appareil, en jours
SESSION_DAYS=30
# Durée du déverrouillage administrateur, en minutes
ADMIN_SESSION_MINUTES=30
# true UNIQUEMENT si l'application est servie en HTTPS (reverse proxy)
COOKIE_SECURE=false
# true UNIQUEMENT derrière un reverse proxy (pour que les logs affichent la vraie IP)
TRUST_PROXY=false
